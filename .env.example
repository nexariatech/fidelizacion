# Supabase: Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres de la app (Supabase: Transaction pooler, puerto 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fidelizacion
# Postgres para migraciones y scripts (Supabase: Session pooler, puerto 5432)
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fidelizacion
# Base usada por las pruebas; se borra y recrea en cada corrida
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fidelizacion_test
# Google Wallet (opcional). Sin estas variables el botón no aparece.
# APP_ORIGIN: URL pública de la app (en Vercel se usa VERCEL_URL si falta)
APP_ORIGIN=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la service account (campo private_key del JSON), con \n literales
GOOGLE_WALLET_PRIVATE_KEY=
# Logo público para la tarjeta; necesario si APP_ORIGIN es localhost
GOOGLE_WALLET_LOGO_URL=
